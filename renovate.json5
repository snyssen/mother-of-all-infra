{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prConcurrentLimit": 0,
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    ":semanticCommits",
    ":pinVersions"
  ],
  "packageRules": [
    // Ignore CalVer
    {
      "matchPackageNames": "lscr.io/linuxserver/transmission",
      "allowedVersions": "!/^\\d{4}\\.\\d{2}\\.\\d{2}/"
    },
    // Ignore test versioning I guess?
    {
      "matchPackageNames": "qmcgaw/gluetun",
      "allowedVersions": "!/^v?1234/"
    },
    // Dawarich: ignore broken update
    {
      "matchPackageNames": "freikin/dawarich",
      "allowedVersions": "!/0.36.3/"
    }
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional"
}
