    {
      "type": "bargauge",
      "title": "Age (power-on time)",
      "description": "Years of actual spinning/powered time, not calendar age. HDD failure rates follow a \"bathtub curve\": slightly higher in the first months, low and flat for years, then rising after about 5 years (Backblaze's fleet data). Seagate warranties: Exos 5 years, IronWolf 3 years. Old is not broken: use this together with the health table.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "Lxg23YOVk"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Lxg23YOVk"
          },
          "editorMode": "code",
          "expr": "max by (device) (smartctl_device_power_on_seconds{instance=\"$instance\"}) / 31557600",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: years",
          "decimals": 1,
          "min": 0,
          "max": 8,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "orange",
                "value": 5
