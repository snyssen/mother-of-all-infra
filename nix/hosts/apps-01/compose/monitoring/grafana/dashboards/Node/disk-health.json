    {
      "type": "stat",
      "title": "btrfs device errors",
      "description": "btrfs's own per-device error counters (read, write, flush, corruption, generation), summed. They persist across reboots until reset with `btrfs device stats -z`, so a non-zero value may be old: the alert only fires when one grows. See the time series below for when it happened.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "Lxg23YOVk"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Lxg23YOVk"
          },
          "editorMode": "code",
          "expr": "sum by (device) (node_btrfs_device_errors_total{instance=\"$instance\"})",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "textMode": "value_and_name",
        "wideLayout": true,
